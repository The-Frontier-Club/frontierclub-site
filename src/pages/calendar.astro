---
import Layout from '../layouts/Layout.astro';

// The 2026–2027 trip calendar. To update: edit this array only.
const trips = [
  { title: 'Cape Town + Victoria Falls', leader: '@harryjaggard, @kieranbrowntravel', dates: 'Nov 14–23, 2026', image: '/images/trip-capetown-vicfalls.jpg' },
  { title: 'African Voodoo', leader: '@michellegoesthere', dates: 'Jan 9–17, 2027', image: '/images/trip-african-voodoo.jpg' },
  { title: 'Brazil Rio Carnaval', leader: '@monicaroams', dates: 'Feb 3–10, 2027', image: '/images/trip-rio-carnaval.jpg' },
  { title: 'Pakistan Hunza + Karakoram', leader: '@jords.media', dates: 'Mar 13–21, 2027', image: '/images/trip-pakistan-hunza.jpg' },
  { title: 'Southern Africa Luxury', leader: '@rin_rudd', dates: 'Apr 3–13, 2027', image: '/images/trip-southern-africa.jpg' },
  { title: 'Kyrgyzstan', leader: '@JudeRusga', dates: 'May 2–10, 2027', image: '/images/trip-kyrgyzstan.jpg' },
  { title: 'Colombia', leader: '@arthur_hill', dates: 'Jun 5–12, 2027', image: '/images/trip-colombia.jpg' },
  { title: 'Bali Creator Camp', leader: '@benbookstheworld', dates: 'Jun 30 – Jul 5, 2027', image: '/images/trip-bali.jpg' },
  { title: 'Kenya and Tanzania', leader: '@mcmungo.tv', dates: 'Aug 3–14, 2027', image: '/images/trip-kenya-tanzania.jpg' },
  { title: 'China', leader: '@travelswithrena', dates: 'Aug 31 – Sep 11, 2027', image: '/images/trip-china.jpg' },
  { title: 'Yemen', leader: '@katie.caf', dates: 'Oct 4–10, 2027', image: '/images/trip-yemen.jpg' },
  { title: 'Afghanistan', leader: '@roxadventures', dates: 'Oct 14–21, 2027', image: '/images/trip-afghanistan.jpg' },
];
---

<Layout
  title="Trip Calendar"
  description="Every Frontier Club departure through 2027 — creator-led small-group trips. Small groups. Big personalities."
>
  <section class="page-header">
    <span class="badge header-badge">{trips.length} DEPARTURES CONFIRMED</span>
    <h1>Upcoming departures</h1>
    <p class="header-lede">
      Small groups. Big personalities. Here's where we're headed next.
    </p>
  </section>

  <section class="cards-wrap">
    <div class="cards">
      {trips.map((trip) => (
        <article class="card">
          <img src={trip.image} alt={trip.title} loading="lazy" />
          <div class="card-body">
            <h2>{trip.title}</h2>
            <p>led by {trip.leader} · {trip.dates}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="waitlist">
    <h2>Don't see your trip yet?</h2>
    <p class="waitlist-copy">
      New departures get added throughout the year. Join the waitlist and
      we'll let you know the moment one opens.
    </p>
    <form
      class="waitlist-form"
      name="waitlist"
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
    >
      <input type="hidden" name="form-name" value="waitlist" />
      <p class="hidden-field">
        <label>Do not fill this out: <input name="bot-field" /></label>
      </p>
      <input
        type="email"
        name="email"
        placeholder="you@email.com"
        aria-label="Email address"
        required
      />
      <button type="submit" class="btn btn--accent waitlist-btn">Join 🚀</button>
    </form>
  </section>
</Layout>

<style>
  .header-badge {
    margin-bottom: 22px;
  }

  .header-lede {
    margin: 18px auto 0;
    max-width: 520px;
    font-size: clamp(14px, 1.4vw, 16px);
    line-height: 1.6;
    color: #000;
    font-weight: 700;
  }

  .cards-wrap {
    max-width: 1100px;
    margin: 0 auto;
    padding: 56px 28px 20px;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  .card {
    background: var(--color-card);
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(43, 31, 61, 0.08);
  }

  .card img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .card-body {
    padding: 20px;
  }

  .card-body h2 {
    font-weight: 600;
    font-size: 16px;
    margin-bottom: 6px;
  }

  .card-body p {
    font-size: 13px;
    color: var(--color-ink-soft);
    margin: 0;
  }

  .waitlist {
    padding: 70px 28px;
    text-align: center;
    background: var(--color-surface);
    margin-top: 40px;
  }

  .waitlist h2 {
    font-weight: 600;
    font-size: clamp(22px, 3vw, 28px);
    color: var(--color-accent);
    margin-bottom: 14px;
  }

  .waitlist-copy {
    font-size: 15px;
    color: var(--color-ink-soft);
    line-height: 1.6;
    max-width: 440px;
    margin: 0 auto;
  }

  .waitlist-form {
    margin: 26px auto 0;
    display: flex;
    background: #fff;
    border: 2px solid var(--color-accent);
    border-radius: 100px;
    padding: 6px 6px 6px 22px;
    align-items: center;
    gap: 10px;
    max-width: 400px;
  }

  .waitlist-form input[type='email'] {
    border: none;
    outline: none;
    background: transparent;
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--color-ink);
    flex: 1;
    min-width: 0;
  }

  .waitlist-btn {
    flex: none;
    font-size: 13px;
    padding: 12px 22px;
    border-radius: 100px;
  }

  .hidden-field {
    display: none;
  }

  @media (max-width: 960px) {
    .cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
