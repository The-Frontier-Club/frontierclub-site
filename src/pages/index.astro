---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Creator-led group travel"
  description="The Frontier Club curates real communities of people chasing transformational experiences — creator-led trips to places most people never go."
>
  <!-- HERO -->
  <section class="hero">
    <img class="hero-photo" src="/images/home-3.jpg" alt="" />
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="hero-inner container">
      <span class="badge">PEAK EXPERIENCES ONLY</span>
      <h1>Join the <span class="lime">Frontier Club</span></h1>
      <p class="hero-lede">Dare to say yes.</p>
      <form
        id="waitlist"
        class="signup hero-signup"
        name="waitlist"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
      >
        <input type="hidden" name="form-name" value="waitlist" />
        <p class="hidden-field">
          <label>Do not fill this out: <input name="bot-field" /></label>
        </p>
        <input
          type="email"
          name="email"
          placeholder="you@email.com"
          aria-label="Email address"
          required
        />
        <button type="submit" class="btn btn--dark">Join the waitlist</button>
      </form>
    </div>
  </section>

  <!-- PHOTO TRIO -->
  <section class="photos container">
    <img src="/images/home-1.jpg" alt="Creator trip photo" loading="lazy" />
    <img
      class="photo-mid"
      src="/images/home-2.jpg"
      alt="Group community photo"
      loading="lazy"
    />
    <img
      src="/images/trip-pakistan-hunza.jpg"
      alt="Destination photo"
      loading="lazy"
    />
  </section>

  <!-- HOW IT WORKS -->
  <section class="how-wrap">
    <h2>How it works</h2>
    <div class="how container">
      <div class="step">
        <div class="num">1</div>
        <h3>Pick a trip</h3>
        <p>Tell us where you want to go and we'll send the departure list first.</p>
      </div>
      <div class="step">
        <div class="num">2</div>
        <h3>Reserve your spot</h3>
        <p>Groups are small and trips sell out — we'll walk you through booking.</p>
      </div>
      <div class="step">
        <div class="num">3</div>
        <h3>Go</h3>
        <p>Experienced operators handle logistics. You just show up.</p>
      </div>
    </div>
  </section>

  <!-- CLOSING WAITLIST -->
  <section class="waitlist">
    <h2>Join the waitlist today</h2>
    <p class="waitlist-copy">
      First departures are coming in hot. Get the dates before anyone else does.
    </p>
    <form
      class="signup waitlist-form"
      name="waitlist"
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
    >
      <input type="hidden" name="form-name" value="waitlist" />
      <p class="hidden-field">
        <label>Do not fill this out: <input name="bot-field" /></label>
      </p>
      <input
        type="email"
        name="email"
        placeholder="you@email.com"
        aria-label="Email address"
        required
      />
      <button type="submit" class="btn btn--dark">Join the waitlist</button>
    </form>
  </section>
</Layout>

<style>
  /* HERO */
  .hero {
    position: relative;
    min-height: 620px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .hero-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(25, 25, 25, 0.55) 0%,
      rgba(25, 25, 25, 0.85) 100%
    );
  }

  .hero-inner {
    position: relative;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    padding-top: 150px;
    padding-bottom: 60px;
  }

  .hero h1 {
    font-size: clamp(58px, 8vw, 104px);
    color: var(--color-off);
    max-width: 800px;
    margin: 0;
  }

  .lime {
    color: var(--color-lime);
  }

  .hero-lede {
    font-size: clamp(20px, 2.4vw, 26px);
    font-weight: 500;
    line-height: 1.4;
    color: #e2e2e2;
    margin: 0;
  }

  .hero-signup {
    margin-top: 8px;
    box-shadow: 5px 5px 0 var(--color-brown);
  }

  /* PHOTO TRIO */
  .photos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    padding-top: 64px;
    padding-bottom: 64px;
  }

  .photos img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .photo-mid {
    margin-top: 26px;
  }

  /* HOW IT WORKS — lime slab */
  .how-wrap {
    background: var(--color-lime);
    padding: 72px 0;
  }

  .how-wrap h2 {
    font-size: clamp(38px, 5vw, 56px);
    color: var(--color-black);
    text-align: center;
    margin-bottom: 44px;
  }

  .how {
    max-width: 940px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  .step {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .num {
    font-family: var(--font-display);
    font-size: 60px;
    line-height: 1;
    color: var(--color-olive);
  }

  .step h3 {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 19px;
    color: var(--color-black);
    margin: 0;
  }

  .step p {
    font-size: 14px;
    line-height: 1.6;
    color: #3c4430;
    max-width: 250px;
    margin: 0;
  }

  /* CLOSING WAITLIST — brown */
  .waitlist {
    background: var(--color-brown);
    padding: 72px 28px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .waitlist h2 {
    font-size: clamp(34px, 4vw, 48px);
    color: var(--color-off);
    margin: 0;
  }

  .waitlist-copy {
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-tan);
    max-width: 440px;
    text-align: center;
    margin: 0;
  }

  .waitlist-form {
    margin-top: 14px;
  }

  .hidden-field {
    display: none;
  }

  /* MOBILE */
  @media (max-width: 720px) {
    .hero {
      min-height: 540px;
    }

    .hero-inner {
      padding-top: 110px;
      padding-bottom: 44px;
    }

    .photos {
      grid-template-columns: 1fr;
    }

    .photo-mid {
      margin-top: 0;
    }

    .how {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>
