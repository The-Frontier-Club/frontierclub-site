---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact"
  description="Questions about a trip, booking, or becoming a leader — reach out to The Frontier Club."
>
  <section class="page-header">
    <h1>Let's talk</h1>
    <p class="header-lede">
      Questions about a trip, booking, or becoming a leader — reach out.
    </p>
  </section>

  <section class="form-wrap">
    <form
      name="trip-inquiry"
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
    >
      <input type="hidden" name="form-name" value="trip-inquiry" />
      <p class="hidden-field">
        <label>Do not fill this out: <input name="bot-field" /></label>
      </p>

      <div class="field">
        <label for="name">Name</label>
        <input type="text" id="name" name="name" placeholder="Your name" required />
      </div>

      <div class="field">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" placeholder="you@email.com" required />
      </div>

      <div class="field">
        <label for="message">Message</label>
        <textarea
          id="message"
          name="message"
          rows="5"
          placeholder="What's on your mind?"></textarea>
      </div>

      <button type="submit" class="btn btn--accent">Send message →</button>
    </form>
  </section>
</Layout>

<style>
  .header-lede {
    margin: 18px auto 0;
    max-width: 480px;
    font-size: clamp(14px, 1.4vw, 16px);
    line-height: 1.6;
    color: #fff;
    font-weight: 700;
  }

  .form-wrap {
    max-width: 560px;
    margin: 0 auto;
    padding: 64px 28px 90px;
  }

  form {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: var(--color-nav-link);
    margin-bottom: 6px;
  }

  input,
  textarea {
    width: 100%;
    border: 2px solid rgba(140, 74, 156, 0.25);
    border-radius: 12px;
    padding: 13px 16px;
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--color-ink);
    outline: none;
    background: #fff;
  }

  textarea {
    resize: vertical;
  }

  input:focus,
  textarea:focus {
    border-color: var(--color-accent);
  }

  button {
    align-self: flex-start;
    font-size: 14px;
    padding: 14px 28px;
  }

  .hidden-field {
    display: none;
  }
</style>
