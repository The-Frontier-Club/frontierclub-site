---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact"
  description="Ask about a trip, get on the list for new departures, or reach the Frontier Club team."
>
  <section class="section">
    <div class="container narrow">
      <h1>Get in touch</h1>
      <p class="lede">
        Ask about a trip, get notified about new departures, or just say
        hello.
      </p>

      <!--
        This form is wired for Netlify Forms: the `data-netlify` attribute
        and hidden `form-name` input make it work automatically once the
        site is hosted on Netlify. No backend needed.
      -->
      <form
        name="trip-inquiry"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
      >
        <input type="hidden" name="form-name" value="trip-inquiry" />
        <p class="hidden-field">
          <label>Do not fill this out: <input name="bot-field" /></label>
        </p>

        <div class="field">
          <label for="name">Name</label>
          <input type="text" id="name" name="name" required />
        </div>

        <div class="field">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" required />
        </div>

        <div class="field">
          <label for="trip">Which trip are you interested in?</label>
          <input
            type="text"
            id="trip"
            name="trip"
            placeholder="Or 'not sure yet'"
          />
        </div>

        <div class="field">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="5"></textarea>
        </div>

        <button type="submit" class="btn">Send inquiry</button>
      </form>
    </div>
  </section>
</Layout>

<style>
  .narrow {
    max-width: 36rem;
  }

  .lede {
    font-size: 1.15rem;
  }

  form {
    margin-top: var(--space-5);
  }

  .field {
    margin-bottom: var(--space-4);
  }

  label {
    display: block;
    font-weight: 600;
    margin-bottom: var(--space-2);
  }

  input,
  textarea {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid var(--color-line);
    font: inherit;
    background: var(--color-bg);
  }

  input:focus,
  textarea:focus {
    outline: 2px solid var(--color-ink);
    outline-offset: 1px;
  }

  .hidden-field {
    display: none;
  }
</style>
