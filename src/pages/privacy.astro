---
// /privacy — Privacy policy page (GDPR requirement flagged in the original
// project brief). Reuses the site's rich-text pattern (`text-rich-text
// w-richtext`, same as blog/episode body copy) rather than the punchy
// all-caps marketing typography — a legal document needs to read like one.
//
// IMPORTANT: this is a drafted starting point, not legal advice. Before this
// goes live with a real application form collecting real people's data, it
// needs sign-off from an actual lawyer familiar with UK/Gibraltar/EU data
// protection law — this file has several [TODO] markers for facts only the
// founders or a lawyer can confirm (legal entity name, registered address,
// which specific tools are actually in use, supervisory authority).
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/#founders', label: 'The Founders' },
  { href: '/#trip', label: 'The Trip' },
  { href: '/#stories', label: 'Stories' },
];

const lastUpdated = 'September 2026'; // TODO: update when actually published

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Privacy Policy',
  url: new URL('/privacy', Astro.site).toString(),
  about: { '@type': 'Organization', name: 'The Frontier Club' },
};
---
<BaseLayout
  title="Privacy Policy — The Frontier Club"
  description="How The Frontier Club collects, uses, and protects your personal data."
  schema={schema}
>
  <Navbar navLinks={navLinks} logoSrc="/images/frontier-club-logo.png" brand="The Frontier Club" />

  <main class="main-wrapper">
    <section class="section_hero">
      <div class="padding-global">
        <div class="container-large">
          <div class="w-layout-vflex content_top">
            <div data-reveal="left">
              <div class="tag">
                <div class="text_tag">Legal</div>
              </div>
            </div>
            <h1 data-reveal="left" data-reveal-delay="100" class="h1_hero">Privacy Policy</h1>
            <div data-reveal="left" data-reveal-delay="200" class="text-color-secondary">Last updated: {lastUpdated}</div>
          </div>
        </div>
      </div>
      <div class="padding-section-medium"></div>
    </section>

    <section>
      <div class="padding-global">
        <div class="container-large">
          <div class="privacy-content text-rich-text w-richtext">

            <h3>1. Who we are</h3>
            <p>
              The Frontier Club ("we," "us," "our") is a group travel community
              founded by Harry Jaggard and Kieran Brown.
              <!-- TODO: confirm and insert the actual legal entity name,
                   registered address, and company/registration number once
                   the business is formally set up. -->
            </p>
            <p>
              If you have any questions about this policy or how we handle
              your data, contact us at
              contact@joinfrontierclub.com.
            </p>

            <h3>2. What data we collect</h3>
            <p>We collect personal data in three places on this site:</p>
            <ul role="list">
              <li><strong>The application form.</strong> When you apply, we collect your name, email address, and whatever else the application asks (e.g. your answers to screening questions). <!-- TODO: this form is currently hosted on a third-party tool (Typeform/Tally) — name the specific one once chosen. --></li>
              <li><strong>Community sign-up.</strong> If you join our community platform, that platform collects the details it needs to create your account.</li>
              <li><strong>Email updates.</strong> If you sign up for updates, we collect your email address to send them.</li>
            </ul>
            <p>
              We do not currently use cookies or analytics tracking on this
              site. If that changes — for example, if we add site analytics
              later — this policy will be updated to reflect it, and this
              section should be revisited at that point.
            </p>

            <h3>3. How we use your data</h3>
            <ul role="list">
              <li>To review and respond to your application</li>
              <li>To administer accepted trips (communicating logistics, dates, and requirements)</li>
              <li>To send you updates you've asked to receive</li>
              <li>To maintain the security and proper functioning of our systems</li>
            </ul>
            <p>
              We do not sell your personal data, and we do not use it for
              purposes beyond what's described here without asking you first.
            </p>

            <h3>4. Our legal basis for processing</h3>
            <p>
              Where you apply for a trip, we process your data on the basis
              of <strong>consent</strong> (you choosing to apply) and, if
              accepted, <strong>contractual necessity</strong> (we need your
              details to actually run the trip you've booked onto). Where you
              sign up for community access or email updates, we rely on your
              <strong>consent</strong>, which you can withdraw at any time.
            </p>

            <h3>5. Who we share your data with</h3>
            <p>
              We use a small number of third-party tools to run the parts of
              this operation we haven't built ourselves. Each acts as a data
              processor on our behalf:
            </p>
            <ul role="list">
              <li><strong>Application form provider</strong> <!-- TODO: name it (Typeform, Tally, etc.) --> — collects and stores your application responses.</li>
              <li><strong>Airtable</strong> — where accepted applications are organized for the founders to review.</li>
              <li><strong>Email provider</strong> <!-- TODO: name it (Mailchimp, ConvertKit, etc.) --> — sends update emails to people who've signed up.</li>
              <li><strong>Cloudflare</strong> — hosts this website.</li>
            </ul>
            <p>
              We do not share your data with anyone outside this list unless
              we're legally required to, or unless we tell you and get your
              agreement first.
            </p>

            <h3>6. International data transfers</h3>
            <p>
              Some of the tools listed above may store data on servers
              outside the UK, Gibraltar, or the EEA.
              <!-- TODO: confirm which tools, where they store data, and
                   whether appropriate safeguards (e.g. Standard Contractual
                   Clauses) are in place — a lawyer should check this
                   against the specific tools actually chosen. -->
            </p>

            <h3>7. How long we keep your data</h3>
            <p>
              If your application isn't accepted, we keep your details for a
              reasonable period in case a similar trip comes up, then delete
              them. If you're accepted onto a trip, we keep your details for
              as long as needed to run that trip and to meet any legal or
              accounting obligations afterward. You can ask us to delete your
              data sooner at any time — see Section 8.
            </p>

            <h3>8. Your rights</h3>
            <p>Under data protection law, you have the right to:</p>
            <ul role="list">
              <li>Ask what personal data we hold about you, and get a copy of it</li>
              <li>Ask us to correct inaccurate data</li>
              <li>Ask us to delete your data</li>
              <li>Ask us to restrict how we use your data</li>
              <li>Object to how we're using your data</li>
              <li>Withdraw consent at any time, where we're relying on consent</li>
              <li>Move your data to another provider (data portability)</li>
              <li>Complain to your local data protection authority if you think we've done something wrong</li>
            </ul>
            <p>
              To exercise any of these rights, email us at
              contact@joinfrontierclub.com.
              <!-- TODO: name the specific supervisory authority applicants
                   should be able to complain to (e.g. the ICO for the UK,
                   the Gibraltar Regulatory Authority, or the relevant EU
                   authority) — depends on where the business is legally
                   established, which needs confirming. -->
            </p>

            <h3>9. Children</h3>
            <p>
              This site and our trips are intended for adults. We don't
              knowingly collect personal data from anyone under 18.
            </p>

            <h3>10. Changes to this policy</h3>
            <p>
              We may update this policy from time to time. If we make
              significant changes, we'll update the "last updated" date at
              the top of this page.
            </p>

          </div>
        </div>
      </div>
      <div class="padding-section-medium"></div>
    </section>
  </main>

  <Footer />
</BaseLayout>
