---
// /episodes — Episodes listing (from episode-s/episodes-v-1.html).
// Source order: section_portfolio (CMS episodes grid, its content_top is the
// page hero "Latest Episodes Showcase") -> section_stories -> section_loop ->
// footer. PortfolioSection renders the heading as the page <h1> here.
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import LoopSection from '../../components/LoopSection.astro';
import StoriesSection from '../../components/StoriesSection.astro';
import PortfolioSection from '../../components/PortfolioSection.astro';
import FrequencySection from '../../components/FrequencySection.astro';

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About Us' },
  { href: '/episodes', label: 'Episodes' },
  { href: '/blog', label: 'Blog' },
  { href: '/contact', label: 'Contact Us' },
];

const episodes = await getCollection('episodes');
const schema = {
  '@context': 'https://schema.org',
  '@type': 'PodcastSeries',
  name: 'Lyria',
  description:
    'A podcast where every note holds a narrative and every silence a secret — captivating stories and insights from Lyria.',
  url: new URL('/episodes', Astro.site).toString(),
  numberOfEpisodes: episodes.length,
  publisher: { '@type': 'Organization', name: 'Lyria' },
};
---
<BaseLayout
  title="Episodes — Lyria"
  description="Latest episodes showcase. Discover captivating stories and insights from the Lyria podcast."
  schema={schema}
>
  <Navbar navLinks={navLinks} logoSrc="/images/Lyria-3.svg" brand="Lyria" />

  <main class="main-wrapper">
    <PortfolioSection headingTag="h1" />
    <StoriesSection headlineDelay={100} revealQuotes={false} />
    <LoopSection />
    <FrequencySection isSecond />
  </main>

  <Footer />
</BaseLayout>
