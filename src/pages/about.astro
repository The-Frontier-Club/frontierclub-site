---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import LoopSection from '../components/LoopSection.astro';
import ReviewSection from '../components/ReviewSection.astro';
import TeamSection from '../components/TeamSection.astro';
import FrequencySection from '../components/FrequencySection.astro';

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About Us' },
  { href: '/episodes', label: 'Episodes' },
  { href: '/blog', label: 'Blog' },
  { href: '/contact', label: 'Contact Us' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  url: new URL('/about', Astro.site).toString(),
  mainEntity: {
    '@type': 'Person',
    name: 'Brandon Green',
    jobTitle: 'Podcast Host',
    description:
      'A former journalist who explores the human experience through audio storytelling, turning everyday moments into unforgettable tales.',
    worksFor: { '@type': 'Organization', name: 'Lyria' },
  },
};
---
<BaseLayout
  title="About Lyria — Meet Brandon Green & the Team"
  description="Brandon Green is a former journalist who explores the human experience through audio storytelling. Meet the host and the team behind Lyria."
  schema={schema}
>
  <Navbar navLinks={navLinks} logoSrc="/images/Lyria-3.svg" brand="Lyria" />

  <main class="main-wrapper">
    <!-- HERO -->
    <section class="section_hero">
      <div class="padding-global">
        <div class="container-large">
          <div class="hero_container">
            <div class="latest_grid">
              <div class="w-layout-vflex hero_content_left-wrap">
                <div class="content_top">
                  <h1 data-reveal="left">About Lyria host</h1>
                  <div data-reveal="left" data-reveal-delay="100" class="text-color-secondary hide-mobile-landscape">Brandon Green is a former journalist who explores the human experience through audio storytelling. With a rich background in media, he captivates audiences by turning everyday moments into unforgettable tales.</div>
                </div>
                <div class="text_bottom-grid">
                  <div data-reveal="left" data-reveal-delay="200" class="hero_content_text">
                    <div class="tag">
                      <div class="text_tag">Background</div>
                    </div>
                    <div class="text-color-secondary">Brandon has been featured in renowned publications such as MTV and Pitchfork</div>
                  </div>
                  <div data-reveal="left" data-reveal-delay="300" class="hero_content_text">
                    <div class="tag">
                      <div class="text_tag">Passion</div>
                    </div>
                    <div class="text-color-secondary">He has a unique talent for crafting extraordinary stories from ordinary experiences.</div>
                  </div>
                </div>
              </div>
              <div data-reveal="right" data-reveal-delay="100" class="hero_visual"><img src="/images/Frame-112.avif" loading="lazy" sizes="(max-width: 1256px) 100vw, 1256px" srcset="/images/Frame-112-p-500.avif 500w, /images/Frame-112.avif 1256w" alt="Brandon Green, host of Lyria" class="img-parallax"></div>
            </div>
          </div>
        </div>
      </div>
      <div class="padding-section-medium"></div>
    </section>

    <LoopSection />

    <!-- ECHOES IN FRAME -->
    <section class="section_frame">
      <div class="padding-section-medium"></div>
      <div class="padding-global">
        <div class="container-large">
          <div class="w-layout-vflex vertical-center">
            <h2>Echoes in frame</h2>
            <div class="text-color-secondary">Explore the creativity of our talented creators.</div>
          </div>
          <div class="spacer">
            <div style="padding-top: 4.5rem" class="spacer-desktop"></div>
            <div style="padding-top: 3.5rem" class="spacer-tablet"></div>
            <div style="padding-top: 2.5rem" class="spacer-mobile"></div>
          </div>
          <div class="frame_container">
            <div class="frame_visual_items">
              <div data-reveal="left" class="visual_left"><img src="/images/Frame-90.avif" loading="lazy" sizes="(max-width: 1520px) 100vw, 1520px" srcset="/images/Frame-90-p-500.avif 500w, /images/Frame-90-p-800.avif 800w, /images/Frame-90.avif 1520w" alt="" class="img"></div>
              <div data-reveal="right" data-reveal-delay="100" class="visual_right"><img loading="lazy" src="/images/Frame-91.avif" alt="" class="img"></div>
            </div>
            <div class="frame_visual_items is_second">
              <div data-reveal="left" data-reveal-delay="200" class="visual_right"><img src="/images/Frame-113.avif" loading="lazy" alt="" class="img"></div>
              <div data-reveal="right" data-reveal-delay="300" class="visual_left"><img src="/images/Frame-114.avif" loading="lazy" sizes="(max-width: 1520px) 100vw, 1520px" srcset="/images/Frame-114-p-500.avif 500w, /images/Frame-114-p-800.avif 800w, /images/Frame-114.avif 1520w" alt="" class="img"></div>
            </div>
          </div>
        </div>
      </div>
      <div class="padding-section-medium"></div>
    </section>

    <ReviewSection />
    <TeamSection />
    <FrequencySection isSecond />
  </main>

  <Footer />
</BaseLayout>
