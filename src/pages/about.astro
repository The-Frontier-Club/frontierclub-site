---
import Layout from '../layouts/Layout.astro';

const team = [
  { name: 'Harry Jaggard', role: 'Co-Founder', photo: '/images/team-harry.jpg' },
  { name: 'Kieran Brown', role: 'Co-Founder', photo: '/images/team-kieran.jpg' },
  { name: 'Harris Courson', role: 'CEO', photo: '/images/team-harris.jpg' },
  { name: 'Josh Bailey', role: 'Operations', photo: '/images/team-josh.jpg' },
  { name: 'David Hitchcock', role: 'Marketing', photo: '/images/team-david.jpg' },
];
---

<Layout
  title="About"
  description="The Frontier Club curates authentic communities of people seeking transformational experiences, for a world that increasingly seeks in-person connection."
>
  <section class="page-header">
    <h1>Why we exist</h1>
  </section>

  <section class="mission">
    <p>
      "We curate authentic communities of people seeking transformational
      experiences, for a world that increasingly seeks in-person connection."
    </p>
  </section>

  <section class="split container">
    <div class="panel">
      <h2>What we're building</h2>
      <p>
        The most adventurous and fun travel company — one that consistently
        delights fans and creators by delivering peak experiences in places
        most people never go.
      </p>
    </div>
    <div class="panel">
      <h2>How we do it</h2>
      <p>
        Small groups, led by the creators whose adventures you already
        follow, with logistics handled by experienced operators — so you can
        just show up.
      </p>
    </div>
  </section>

  <section class="team">
    <h2>The team</h2>
    <div class="team-grid">
      {team.map((member) => (
        <div class="member">
          <img src={member.photo} alt={member.name} loading="lazy" />
          <h3>{member.name}</h3>
          <p>{member.role}</p>
        </div>
      ))}
    </div>
  </section>
</Layout>

<style>
  .mission {
    max-width: 760px;
    margin: 0 auto;
    padding: 70px 28px;
    text-align: center;
  }

  .mission p {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(20px, 2.6vw, 28px);
    line-height: 1.5;
    color: var(--color-ink);
    margin: 0;
  }

  .split {
    max-width: 1000px;
    padding-bottom: 90px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
  }

  .panel {
    background: var(--color-card);
    border-radius: 20px;
    padding: 36px;
  }

  .panel h2 {
    font-weight: 600;
    font-size: 18px;
    color: var(--color-accent);
    margin-bottom: 14px;
  }

  .panel p {
    font-size: 14.5px;
    color: var(--color-ink-soft);
    line-height: 1.7;
    margin: 0;
  }

  .team {
    padding: 70px 28px;
    background: var(--color-surface);
    text-align: center;
  }

  .team h2 {
    font-weight: 600;
    font-size: clamp(20px, 2.6vw, 26px);
    color: var(--color-accent);
    margin-bottom: 30px;
  }

  .team-grid {
    display: flex;
    gap: 36px;
    justify-content: center;
    flex-wrap: wrap;
    max-width: 820px;
    margin: 0 auto;
  }

  .member {
    width: 130px;
  }

  .member img {
    width: 110px;
    height: 110px;
    margin: 0 auto;
    border-radius: 50%;
    object-fit: cover;
  }

  .member h3 {
    font-weight: 600;
    font-size: 14px;
    color: var(--color-ink);
    margin: 14px 0 0;
  }

  .member p {
    font-size: 12px;
    color: var(--color-ink-soft);
    margin: 2px 0 0;
  }

  @media (max-width: 720px) {
    .split {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
</style>
