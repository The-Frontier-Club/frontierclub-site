---
// ReviewSection.astro — about page quote/review (section_review).
// Listener image + split pull-quote ("Notes whisper stories. / Silence speaks
// volumes."). IX inline initial states stripped (static page); `highlight`
// animation hook preserved on the quote block.
---
<section class="section_review">
  <div class="padding-section-medium"></div>
  <div class="padding-global">
    <div class="container-large">
      <div class="review_wrap">
        <div data-reveal="left" class="listener_img"><img loading="lazy" src="/images/Frame-115.avif" alt="Listener portrait" class="img"></div>
        <div animation="highlight" class="about_content is-left">
          <div class="max-title is-50rem">
            <h2 class="h2_about">&quot;Notes whisper stories. </h2>
          </div>
          <div class="text_rigth">
            <div class="max-title is-55rem">
              <h2 class="h2_about">Silence speaks volumes.&quot;</h2>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="padding-section-medium"></div>
</section>
