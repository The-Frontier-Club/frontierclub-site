---
const links = [
  { href: '/', label: 'Home' },
  { href: '/calendar/', label: 'Trip Calendar' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
const current = Astro.url.pathname;
---

<header class="site-header">
  <div class="container nav-inner">
    <a href="/" class="wordmark">Frontier Club</a>
    <nav aria-label="Main navigation">
      <ul>
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={current === link.href ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-line);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-top: 20px;
    padding-bottom: 20px;
    flex-wrap: wrap;
  }

  .wordmark {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 18px;
    color: var(--color-accent);
  }

  ul {
    display: flex;
    gap: 32px;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }

  nav a {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-nav-link);
  }

  nav a:hover {
    color: var(--color-pink);
  }

  nav a[aria-current='page'] {
    color: var(--color-ink);
  }

  @media (max-width: 720px) {
    ul {
      gap: 18px;
    }

    nav a {
      font-size: 13px;
    }
  }
</style>
