---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <p class="wordmark">The Frontier Club</p>
    <nav aria-label="Footer navigation">
      <ul>
        <li><a href="/calendar/">Trip Calendar</a></li>
        <li><a href="/leaders/">Trip Leaders</a></li>
        <li><a href="/about/">About</a></li>
        <li><a href="/contact/">Contact</a></li>
      </ul>
    </nav>
    <p class="legal">&copy; {year} The Frontier Club. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-line);
    margin-top: var(--space-7);
    padding: var(--space-5) 0;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-ink);
    margin: 0;
  }

  ul {
    display: flex;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }

  a {
    text-decoration: none;
    font-size: 0.9rem;
  }

  .legal {
    font-size: 0.8rem;
    margin: 0;
  }
</style>
