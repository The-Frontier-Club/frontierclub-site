---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <p class="wordmark">Frontier Club</p>
    <nav aria-label="Footer navigation">
      <ul>
        <li><a href="/calendar/">Trip Calendar</a></li>
        <li><a href="/about/">About</a></li>
        <li><a href="/contact/">Contact</a></li>
      </ul>
    </nav>
    <p class="legal">&copy; {year} The Frontier Club</p>
  </div>
</footer>

<style>
  .site-footer {
    padding: 36px 0;
    background: var(--color-ink);
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
  }

  .wordmark {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 15px;
    color: var(--color-bg);
    margin: 0;
  }

  ul {
    display: flex;
    gap: 24px;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }

  a,
  a:hover {
    font-size: 13px;
    color: var(--color-lilac);
  }

  a:hover {
    color: var(--color-bg);
  }

  .legal {
    font-size: 12px;
    color: var(--color-lilac-soft);
    margin: 0;
  }
</style>
