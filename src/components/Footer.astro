---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <p class="wordmark">Frontier Club</p>
    <p class="legal">&copy; {year} The Frontier Club</p>
  </div>
</footer>

<style>
  .site-footer {
    padding: 32px 0;
    background: var(--color-black);
    border-top: 1px solid var(--color-line);
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
  }

  .wordmark {
    font-family: var(--font-display);
    font-size: 18px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-off);
    margin: 0;
  }

  .legal {
    font-size: 12px;
    color: #7a7268;
    margin: 0;
  }
</style>
